{
    "name": "our-edu/token-claims",
    "description": "IAM token claims client, role middleware and 401/503 session handling for OurEdu Laravel services.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.2",
        "illuminate/http": "^9.0|^10.0|^11.0",
        "illuminate/support": "^9.0|^10.0|^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0",
        "phpunit/phpunit": "^9.5|^10.0"
    },
    "autoload": {
        "psr-4": {
            "OurEdu\\TokenClaims\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OurEdu\\TokenClaims\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OurEdu\\TokenClaims\\TokenClaimsServiceProvider"
            ],
            "aliases": {
                "TokenClaims": "OurEdu\\TokenClaims\\Facades\\TokenClaims"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "keywords": [
        "laravel",
        "iam",
        "token",
        "claims",
        "middleware"
    ]
}
